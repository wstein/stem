[
  {"data":{},"escape":"html","expected":"Just text, no tags.","name":"plain text","template":"Just text, no tags.","transformers":[]},
  {"data":{"body":"<script>x</script>"},"escape":"html","expected":"<p>&lt;script&gt;x&lt;/script&gt;</p>","name":"escaped assign","template":"<p>{{body}}</p>","transformers":[]},
  {"data":{"body":"<b>ok</b>"},"escape":"html","expected":"<p><b>ok</b></p>","name":"raw assign","template":"<p>{{{body}}}</p>","transformers":[]},
  {"data":{},"escape":"html","expected":"[]","name":"missing assign","template":"[{{nope}}]","transformers":[]},
  {"data":{"user":{"name":"Nina","email":"n@x.io"}},"escape":"html","expected":"Nina <n@x.io>","name":"nested path","template":"{{user.name}} <{{user.email}}>","transformers":[]},
  {"data":{"title":"Home"},"escape":"html","expected":"Home","name":"parent path","template":"{{../title}}","transformers":[]},
  {"data":{"name":"  nina  "},"escape":"html","expected":"NINA","name":"string pipeline","template":"{{name |> trim |> upcase}}","transformers":["strings"]},
  {"data":{"tags":["a","b","c"]},"escape":"html","expected":"a, b, c","name":"collection join","template":"{{tags |> join(\", \")}}","transformers":["minimum"]},
  {"data":{"users":[{"name":"A"},{"name":"B"}]},"escape":"html","expected":"A, B","name":"selector map","template":"{{users |> map(\"name\") |> join(\", \")}}","transformers":["minimum","collections"]},
  {"data":{},"escape":"html","expected":"none","name":"default with literal","template":"{{default missing \"none\"}}","transformers":["minimum"]},
  {"data":{"name":"NiNa"},"escape":"html","expected":"NINA","name":"builtin subexpression","template":"{{upcase (downcase name)}}","transformers":["strings"]},
  {"data":{"tags":["a","b"]},"escape":"html","expected":"true","name":"predicate","template":"{{contains tags \"a\"}}","transformers":["predicates"]},
  {"data":{"x":"quote \" here"},"escape":"json","expected":"quote \\\" here","name":"json escape mode","template":"{{x}}","transformers":[]},
  {"data":{"n":42},"escape":"html","expected":"n=42","name":"numeric assign","template":"n={{n}}","transformers":[]},
  {"data":{"active":true},"escape":"html","expected":"on","name":"if/else true","template":"{{#if active}}on{{else}}off{{/if}}","transformers":[]},
  {"data":{"active":false},"escape":"html","expected":"off","name":"if/else false","template":"{{#if active}}on{{else}}off{{/if}}","transformers":[]},
  {"data":{"active":false},"escape":"html","expected":"hidden","name":"unless","template":"{{#unless active}}hidden{{/unless}}","transformers":[]},
  {"data":{"items":["x","y"]},"escape":"html","expected":"0:x 1:y ","name":"each with this and index","template":"{{#each items}}{{@index}}:{{this}} {{/each}}","transformers":[]},
  {"data":{"items":["a","b"]},"escape":"html","expected":"0=a;1=b;","name":"each with block params","template":"{{#each items as |item idx|}}{{idx}}={{item}};{{/each}}","transformers":[]},
  {"data":{"rows":{"a":1,"b":2}},"escape":"html","expected":"a=1 b=2 ","name":"each over a map with key","template":"{{#each rows}}{{@key}}={{this}} {{/each}}","transformers":[]},
  {"data":{"items":[]},"escape":"html","expected":"none","name":"each empty else","template":"{{#each items}}{{this}}{{else}}none{{/each}}","transformers":[]},
  {"data":{"names":["a","b"]},"escape":"html","expected":"A B ","name":"each with transformer","template":"{{#each names}}{{this |> upcase}} {{/each}}","transformers":["strings"]},
  {"data":{"user":{"name":"Nina"}},"escape":"html","expected":"Nina","name":"with this-field","template":"{{#with user}}{{this.name}}{{/with}}","transformers":[]},
  {"data":{"user":{"name":"A"}},"escape":"html","expected":"A","name":"with block param and else","template":"{{#with user as |u|}}{{u.name}}{{else}}none{{/with}}","transformers":[]},
