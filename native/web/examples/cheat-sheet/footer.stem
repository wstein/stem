<div class="foot">
  <div class="legend">
    {{#each main_groups}}<span><i aria-hidden="true" style="background:{{accent}}"></i>{{name}}</span>{{/each}}
    {{#each narrow_groups}}<span><i aria-hidden="true" style="background:{{accent}}"></i>{{name}}</span>{{/each}}
