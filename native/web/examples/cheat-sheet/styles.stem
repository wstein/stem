<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#eef1f6;--surface:#fff;--surface-alt:#f7f8fb;--border:#e2e5ec;--soft:#ecedf2;--ink:#2e2b6b;--ink-soft:#5b59a0;--ink-mute:#8e8db8;--label:#14123a}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
.sheet{max-width:1500px;margin:0 auto;padding:48px 48px 64px}
.top{display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:end;margin-bottom:24px}
.brand{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);font-weight:600}
.brand .mark{width:30px;height:30px}
h1{font-size:46px;font-weight:700;letter-spacing:-.02em;line-height:1.04;margin:12px 0 0;color:var(--label)}
h1 .accent{color:var(--ink-mute);font-weight:400}
.sub{color:var(--ink-soft);font-size:14.5px;max-width:54ch;line-height:1.5;margin-top:12px}
.meta{border:1px solid var(--border);background:var(--surface);border-radius:14px;padding:18px 20px;font-size:13px;color:var(--ink-soft)}
.meta strong{color:var(--label);font-weight:700;font-size:11px;letter-spacing:.12em}
.meta-grid{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;margin-top:10px}
.meta-grid code{font-family:ui-monospace,monospace;font-size:12px;color:var(--ink);background:var(--surface-alt);padding:2px 6px;border-radius:4px;align-self:start}
.syntax{margin:0 0 26px;border:1px solid var(--border);background:var(--surface);border-radius:16px;padding:20px 24px;display:grid;grid-template-columns:170px 1fr 1fr 1fr;gap:24px;align-items:center}
.syntax .lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-mute);font-weight:600}
.syntax .lbl b{display:block;font-size:17px;color:var(--label);margin-top:5px;letter-spacing:0;text-transform:none}
.syntax code{display:block;font-family:ui-monospace,monospace;font-size:13.5px;color:var(--ink);background:var(--surface-alt);border:1px solid var(--soft);padding:13px 15px;border-radius:10px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.col{display:flex;flex-direction:column;gap:20px;min-width:0}
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.head{padding:16px 20px 14px;border-left:4px solid var(--a);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.head .dot{width:9px;height:9px;border-radius:50%;background:var(--a)}
.head h2{font-size:14px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--label)}
.head .pill{font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;padding:4px 9px;border-radius:6px;background:var(--abg);color:var(--a)}
.head .count{margin-left:auto;font-family:ui-monospace,monospace;font-size:11px;color:var(--ink-mute)}
.head .desc{flex-basis:100%;font-size:12.5px;color:var(--ink-soft);line-height:1.45;margin-top:2px}
.rows{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--soft);padding:10px 20px;gap:16px;align-items:start}
.row:nth-child(even){background:#fafbfd}
.expr{font-family:ui-monospace,monospace;font-size:12.5px;color:var(--ink);line-height:1.5;word-break:break-word}
.out{font-family:ui-monospace,monospace;font-size:12.5px;color:var(--ink-soft);line-height:1.5;word-break:break-word}
.out code{color:#16794d;font-family:inherit}.out .muted{color:var(--ink-mute);font-style:italic}
.t-pipe{color:var(--ink-mute)}.t-str{color:#16a36b}.t-num{color:#c2772a}
.note{display:block;font-size:11px;color:var(--ink-mute);margin-top:2px}
.callout{border-top:1px solid var(--soft);padding:11px 20px;font-size:12px;color:var(--ink-soft);background:#fff8ee;display:flex;gap:9px;line-height:1.5}
.callout.warn{background:#fff0f3;color:#8a2942}
.callout .ico{width:15px;height:15px;border-radius:50%;background:var(--a,#f29e3a);color:#fff;flex-shrink:0;margin-top:1px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}
.callout.warn .ico{background:#c2305a}
.callout code{font-family:ui-monospace,monospace;font-size:11.5px}
.codeblock{margin:0;padding:18px 20px;background:#18173a;color:#cfcde8;font-family:ui-monospace,monospace;font-size:12px;line-height:1.65;overflow-x:auto}
.codeblock .c{color:#8b8aaa}.codeblock .m{color:#9ec5ff}.codeblock .f{color:#ffb86b}.codeblock .k{color:#d8a0ff}
.foot{margin-top:30px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-mute);border-top:1px solid var(--border);padding-top:16px}
.foot .legend{display:flex;gap:20px;flex-wrap:wrap}
.foot .legend span{display:inline-flex;align-items:center;gap:7px}
.foot .legend i{width:9px;height:9px;border-radius:50%}
@media (max-width:1000px){
  .sheet{padding:40px 36px 56px}
  .top{grid-template-columns:1fr;align-items:start;gap:20px}
  .syntax{grid-template-columns:1fr;gap:14px}
  .syntax .lbl b{margin-top:2px}
  .cols{grid-template-columns:1fr}
  h1{font-size:38px}
}
@media (max-width:600px){
  .sheet{padding:28px 18px 44px}
  .row{grid-template-columns:1fr;gap:4px}
  .out{padding-top:2px}
  .foot{flex-direction:column;gap:10px;align-items:flex-start}
  h1{font-size:32px}
}
</style>
