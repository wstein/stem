<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#eef1f6;--surface:#fff;--surface-alt:#f7f8fb;--border:#e2e5ec;--soft:#ecedf2;--ink:#2e2b6b;--ink-soft:#5b59a0;--ink-mute:#8e8db8;--label:#14123a}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
.sheet{max-width:1500px;margin:0 auto;padding:48px 48px 64px}
.top{margin-bottom:22px}
.brand{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:14px}
.brand .mark{width:30px;height:30px}
h1{font-size:46px;font-weight:700;letter-spacing:-.02em;line-height:1.04;color:var(--label)}
h1 .accent{color:var(--ink-mute);font-weight:400}
.sub{color:var(--ink-soft);font-size:14.5px;max-width:62ch;line-height:1.5;margin-top:12px}
.sub code{font-family:ui-monospace,monospace;font-size:13px;background:var(--surface-alt);padding:1px 5px;border-radius:4px}
.syntax{margin:22px 0 26px;border:1px solid var(--border);background:var(--surface);border-radius:16px;padding:20px 24px;display:flex;flex-direction:column;gap:14px}
.syntax-row{display:grid;grid-template-columns:150px 1fr 1fr;gap:20px;align-items:center}
.syntax .lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-mute);font-weight:600}
.syntax .lbl b{display:block;font-size:15px;color:var(--label);margin-top:4px;letter-spacing:0;text-transform:none;font-weight:600}
.syntax code{display:block;font-family:ui-monospace,monospace;font-size:13.5px;color:var(--ink);background:var(--surface-alt);border:1px solid var(--soft);padding:13px 15px;border-radius:10px}
.syntax-note{font-size:12px;color:var(--ink-soft);line-height:1.5}
.syntax-note code{display:inline;background:var(--surface-alt);border:none;padding:1px 5px;border-radius:4px;font-family:ui-monospace,monospace;font-size:12px}
.cards{columns:2;column-gap:20px}
.card{break-inside:avoid;-webkit-column-break-inside:avoid;margin:0 0 20px;background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.head{padding:16px 20px 14px;border-left:4px solid var(--a);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.head .dot{width:9px;height:9px;border-radius:50%;background:var(--a)}
.head h2{font-size:14px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--label)}
.head .pill{font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;padding:4px 9px;border-radius:6px;background:color-mix(in srgb, var(--a) 14%, transparent);color:var(--a)}
.head .count{margin-left:auto;font-family:ui-monospace,monospace;font-size:11px;color:var(--ink-mute)}
.head .desc{flex-basis:100%;font-size:12.5px;color:var(--ink-soft);line-height:1.45;margin-top:2px}
.rows{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--soft);padding:10px 20px;gap:16px;align-items:start}
.row:nth-child(even){background:#fafbfd}
.expr,.out{font-family:ui-monospace,"JetBrains Mono",monospace;font-size:12.5px;line-height:1.5;word-break:break-word}
.expr code{color:#4f53b8;font-family:inherit}
.out code{color:#16794d;font-family:inherit}
.callout{border-top:1px solid var(--soft);padding:11px 20px;font-size:12px;color:var(--ink-soft);background:#fff8ee;display:flex;gap:9px;line-height:1.5}
.callout.warn{background:#fff0f3;color:#8a2942}
.callout .ico{width:15px;height:15px;border-radius:50%;background:var(--a);color:#fff;flex-shrink:0;margin-top:1px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}
.callout.warn .ico{background:#c2305a}
.codeblock{margin:0;padding:18px 20px;background:#18173a;color:#cfcde8;font-family:ui-monospace,"JetBrains Mono",monospace;font-size:12px;line-height:1.65;overflow-x:auto;white-space:pre}
.foot{margin-top:30px;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-mute);border-top:1px solid var(--border);padding-top:16px}
.foot .legend{display:flex;gap:20px;flex-wrap:wrap}
.foot .legend span{display:inline-flex;align-items:center;gap:7px}
.foot .legend i{width:9px;height:9px;border-radius:50%}
@media (max-width:1000px){
  .sheet{padding:40px 36px 56px}
  .syntax-row{grid-template-columns:1fr;gap:10px}
  .syntax .lbl b{margin-top:2px}
  .cards{columns:1}
  h1{font-size:38px}
}
@media (max-width:600px){
  .sheet{padding:28px 18px 44px}
  .row{grid-template-columns:1fr;gap:4px}
  .foot{flex-direction:column;gap:10px;align-items:flex-start}
  h1{font-size:32px}
}
</style>