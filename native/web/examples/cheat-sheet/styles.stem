<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --accent: #7c4dff;
  --stem-green: #10b981;
}
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 13px;
  background: #f8f9fa;
  color: #1a1a2e;
  padding: 24px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}
.brand .mark { width: 28px; height: 28px; flex: 0 0 28px; display: block; }
h1 {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #1a1a2e;
}
h1 span { font-weight: 400; opacity: .45; font-size: 12px; letter-spacing: .06em; margin-left: 8px; }
.sheet {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto auto;
  gap: 14px;
}
.group { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px #0001; }
/* Row 1: DEFAULT full-width; Row 2: FORMAT + EVAL; Row 3: TRANSFORM full-width; Row 4: ESCAPE full-width */
.group.default   { grid-column: 1 / span 2; grid-row: 1; }
.group.format    { grid-column: 1;           grid-row: 2; }
.group.eval      { grid-column: 2;           grid-row: 2; }
.group.transform { grid-column: 1 / span 2; grid-row: 3; }
.group.escape    { grid-column: 1 / span 2; grid-row: 4; }
.group-head {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 14px;
  border-bottom: 1px solid #eee;
}
.group-head h2 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.badge {
  font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em;
  padding: 1px 5px; border-radius: 3px; opacity: .8; margin-left: 2px;
}
.group table { width: 100%; border-collapse: collapse; }
.group tr { border-bottom: 1px solid #f0f0f0; }
.group tr:last-child { border-bottom: none; }
.group tr:hover { background: #fafafa; }
td { padding: 5px 12px; vertical-align: middle; line-height: 1.5; }
.col-expr { width: 52%; border-right: 1px solid #f0f0f0; }
.col-result { width: 48%; }
code {
  font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
  font-size: 11px;
}
.col-expr code { color: #5c6bc0; }
.col-result code { color: #2d6a4f; }
</style>
