<section class="card" style="--a:{{accent}}">
  <div class="head"><span class="dot"></span><h2>{{name}}</h2><span class="pill">{{pill}}</span><span class="count">{{transformers |> len}}</span><p class="desc">{{desc}}</p></div>
  <div class="rows">{{#each transformers}}{{> row}}{{/each}}</div>
  {{#if callout}}<div class="callout{{#if warn}} warn{{/if}}"><span class="ico">{{#if warn}}!{{else}}A{{/if}}</span><div>{{callout}}</div></div>{{/if}}
</section>