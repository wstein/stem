{{> styles}}
<h1>Stem Transformers <span>reference · all results rendered live</span></h1>
<div class="sheet">

  <!-- ── DEFAULT ─────────────────────────────── -->
  <div class="group">
    <div class="group-head" style="border-left: 3px solid #6b7280">
      <span class="dot" style="background:#6b7280"></span>
      <h2>default</h2>
      <span class="badge" style="background:#6b72201a;color:#6b7280">always on</span>
    </div>
    <table>
        <td class="col-expr expr"><code>{{ unsafe }} |> escape_html</code></td>
        <td class="expr"><code>{{ quote }} |> escape_json</code></td>
        <td class="expr"><code>fruits |> take(3) |> json</code></td>
        <td class="expr"><code>fruits |> take(3) |> inspect</code></td>
        <td class="expr"><code>missing |> default("N/A")</code></td>
        <td class="expr"><code>fruits |> take(3) |> join(", ")</code></td>
        <td class="expr"><code>title |> log</code></td>
        <td class="expr"><code>fruits |> first</code></td>
        <td class="expr"><code>fruits |> last</code></td>
        <td class="expr"><code>fruits |> len</code></td>
        <td class="expr"><code>config |> lookup("host")</code></td>
        <td class="expr"><code>fruits |> lookup(2)</code></td>
        <td class="expr"><code>fruits |> contains("apple")</code></td>
        <td class="expr"><code>title |> starts_with("the")</code></td>
        <td class="expr"><code>title |> ends_with("fox")</code></td>
        <td class="expr"><code>missing |> empty?</code></td>
        <td class="expr"><code>present |> present?</code></td>
      table>
  </div>

  <!-- ── FORMAT ──────────────────────────────── -->
  <div class="group">
    <div class="group-head" style="border-left: 3px solid #22c55e">
      <span class="dot" style="background:#22c55e"></span>
      <h2>format</h2>
      <span class="badge" style="background:#22c55e1a;color:#15803d">low risk · atomic value transforms</span>
    </div>
    <table>
        <td class="col-expr expr"><code>title |> upcase</code></td>
        <td class="expr"><code>blurb |> downcase</code></td>
        <td class="expr"><code>title |> capitalize</code></td>
        <td class="expr"><code>str |> trim</code></td>
        <td class="expr"><code>blurb |> truncate(20, "…")</code></td>
        <td class="expr"><code>title |> replace("quick", "lazy")</code></td>
      table>
  </div>

  <!-- ── TRANSFORM ───────────────────────────── -->
  <div class="group">
    <div class="group-head" style="border-left: 3px solid #f59e0b">
      <span class="dot" style="background:#f59e0b"></span>
      <h2>transform</h2>
      <span class="badge" style="background:#f59e0b1a;color:#92400e">medium risk · structural · may iterate</span>
    </div>
    <table>
        <td class="col-expr expr"><code>csv |> split(",") |> join("|")</code></td>
        <td class="expr"><code>fruits |> take(3) |> join(", ")</code></td>
        <td class="expr"><code>fruits |> drop(3) |> join(", ")</code></td>
        <td class="expr"><code>fruits |> slice(1, 3) |> join(", ")</code></td>
        <td class="expr"><code>fruits |> take(4) |> reverse |> join(", ")</code></td>
        <td class="expr"><code>fruits |> sort |> join(", ")</code></td>
        <td class="expr"><code>people |> sort_by("age") |> map("name") |> join(", ")</code></td>
        <td class="expr"><code>people |> map("name") |> join(", ")</code></td>
        <td class="expr"><code>people |> filter("lead") |> map("name") |> join(", ")</code></td>
        <td class="expr"><code>sparse |> compact |> join(", ")</code></td>
        <td class="expr"><code>fruits |> uniq |> sort |> join(", ")</code></td>
        <td class="expr"><code>nested |> flatten |> join(", ")</code></td>
        <td class="expr"><code>people |> group_by("dept") |> json</code></td>
      table>
  </div>

  <!-- ── EVAL ────────────────────────────────── -->
  <div class="group">
    <div class="group-head" style="border-left: 3px solid #a855f7">
      <span class="dot" style="background:#a855f7"></span>
      <h2>eval</h2>
      <span class="badge" style="background:#a855f71a;color:#7e22ce">dynamic · opt-in</span>
    </div>
    <table>
        <td class="col-expr expr"><code>expr |> eval</code></td>
      table>
  </div>

</div>
