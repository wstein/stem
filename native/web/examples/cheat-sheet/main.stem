{{> styles}}
<div class="brand">
  <svg class="mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M18 10 C14 10 13 12 13 16 L13 21 C13 23 12 24 10 24 C12 24 13 25 13 27 L13 32 C13 36 14 38 18 38"
          stroke="#7c4dff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M30 10 C34 10 35 12 35 16 L35 21 C35 23 36 24 38 24 C36 24 35 25 35 27 L35 32 C35 36 34 38 30 38"
          stroke="#7c4dff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M24 14 L24 40" stroke="#10b981" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M24 24 C21 22 19 22 17 23" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
    <path d="M24 30 C27 28 29 28 31 29" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
    <circle cx="24" cy="14" r="2" fill="#10b981"/>
  </svg>
  <h1>Stem Transformers <span>reference · all results rendered live</span></h1>
</div>
<div class="sheet">

  <!-- ── DEFAULT ─────────────────────────────── -->
  <div class="group default">
    <div class="group-head" style="border-left: 3px solid #6b7280">
      <span class="dot" style="background:#6b7280"></span>
      <h2>default</h2>
      <span class="badge" style="background:#6b72201a;color:#6b7280">always on</span>
    </div>
    <table>
      <tr><td class="col-expr"><code>unsafe |> escape_html</code></td><td class="col-result"><code>{{unsafe |> escape_html}}</code></td></tr>
      <tr><td class="col-expr"><code>quote |> escape_json</code></td><td class="col-result"><code>{{quote |> escape_json}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> take(3) |> json</code></td><td class="col-result"><code>{{fruits |> take(3) |> json}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> take(3) |> inspect</code></td><td class="col-result"><code>{{fruits |> take(3) |> inspect}}</code></td></tr>
      <tr><td class="col-expr"><code>missing |> default("N/A")</code></td><td class="col-result"><code>{{missing |> default("N/A")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> take(3) |> join(", ")</code></td><td class="col-result"><code>{{fruits |> take(3) |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>title |> log</code></td><td class="col-result"><code>{{title |> log}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> first</code></td><td class="col-result"><code>{{fruits |> first}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> last</code></td><td class="col-result"><code>{{fruits |> last}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> len</code></td><td class="col-result"><code>{{fruits |> len}}</code></td></tr>
      <tr><td class="col-expr"><code>config |> lookup("host")</code></td><td class="col-result"><code>{{config |> lookup("host")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> lookup(2)</code></td><td class="col-result"><code>{{fruits |> lookup(2)}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> contains("apple")</code></td><td class="col-result"><code>{{fruits |> contains("apple")}}</code></td></tr>
      <tr><td class="col-expr"><code>title |> starts_with("the")</code></td><td class="col-result"><code>{{title |> starts_with("the")}}</code></td></tr>
      <tr><td class="col-expr"><code>title |> ends_with("fox")</code></td><td class="col-result"><code>{{title |> ends_with("fox")}}</code></td></tr>
      <tr><td class="col-expr"><code>missing |> empty?</code></td><td class="col-result"><code>{{missing |> empty?}}</code></td></tr>
      <tr><td class="col-expr"><code>present |> present?</code></td><td class="col-result"><code>{{present |> present?}}</code></td></tr>
    </table>
  </div>

  <!-- ── FORMAT ──────────────────────────────── -->
  <div class="group format">
    <div class="group-head" style="border-left: 3px solid #22c55e">
      <span class="dot" style="background:#22c55e"></span>
      <h2>format</h2>
      <span class="badge" style="background:#22c55e1a;color:#15803d">low risk · atomic value transforms</span>
    </div>
    <table>
      <tr><td class="col-expr"><code>title |> upcase</code></td><td class="col-result"><code>{{title |> upcase}}</code></td></tr>
      <tr><td class="col-expr"><code>blurb |> downcase</code></td><td class="col-result"><code>{{blurb |> downcase}}</code></td></tr>
      <tr><td class="col-expr"><code>title |> capitalize</code></td><td class="col-result"><code>{{title |> capitalize}}</code></td></tr>
      <tr><td class="col-expr"><code>str |> trim</code></td><td class="col-result"><code>{{str |> trim}}</code></td></tr>
      <tr><td class="col-expr"><code>blurb |> truncate(20, "…")</code></td><td class="col-result"><code>{{blurb |> truncate(20, "…")}}</code></td></tr>
      <tr><td class="col-expr"><code>title |> replace("quick", "lazy")</code></td><td class="col-result"><code>{{title |> replace("quick", "lazy")}}</code></td></tr>
    </table>
  </div>

  <!-- ── TRANSFORM ───────────────────────────── -->
  <div class="group transform">
    <div class="group-head" style="border-left: 3px solid #f59e0b">
      <span class="dot" style="background:#f59e0b"></span>
      <h2>transform</h2>
      <span class="badge" style="background:#f59e0b1a;color:#92400e">medium risk · structural · may iterate</span>
    </div>
    <table>
      <tr><td class="col-expr"><code>csv |> split(",") |> join("|")</code></td><td class="col-result"><code>{{csv |> split(",") |> join("|")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> take(3) |> join(", ")</code></td><td class="col-result"><code>{{fruits |> take(3) |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> drop(3) |> join(", ")</code></td><td class="col-result"><code>{{fruits |> drop(3) |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> slice(1, 3) |> join(", ")</code></td><td class="col-result"><code>{{fruits |> slice(1, 3) |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> take(4) |> reverse |> join(", ")</code></td><td class="col-result"><code>{{fruits |> take(4) |> reverse |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> sort |> join(", ")</code></td><td class="col-result"><code>{{fruits |> sort |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>people |> sort_by("age") |> map("name") |> join(", ")</code></td><td class="col-result"><code>{{people |> sort_by("age") |> map("name") |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>people |> map("name") |> join(", ")</code></td><td class="col-result"><code>{{people |> map("name") |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>people |> filter("lead") |> map("name") |> join(", ")</code></td><td class="col-result"><code>{{people |> filter("lead") |> map("name") |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>sparse |> compact |> join(", ")</code></td><td class="col-result"><code>{{sparse |> compact |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>fruits |> uniq |> sort |> join(", ")</code></td><td class="col-result"><code>{{fruits |> uniq |> sort |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>nested |> flatten |> join(", ")</code></td><td class="col-result"><code>{{nested |> flatten |> join(", ")}}</code></td></tr>
      <tr><td class="col-expr"><code>people |> group_by("dept") |> json</code></td><td class="col-result"><code>{{people |> group_by("dept") |> json}}</code></td></tr>
    </table>
  </div>

  <!-- ── EVAL ────────────────────────────────── -->
  <div class="group eval">
    <div class="group-head" style="border-left: 3px solid #a855f7">
      <span class="dot" style="background:#a855f7"></span>
      <h2>eval</h2>
      <span class="badge" style="background:#a855f71a;color:#7e22ce">dynamic · opt-in</span>
    </div>
    <table>
      <tr><td class="col-expr"><code>expr |> eval</code></td><td class="col-result"><code>{{expr |> eval}}</code></td></tr>
    </table>
  </div>

  <!-- ── ESCAPE ─────────────────────────────── -->
  <div class="group escape">
    <div class="group-head" style="border-left: 3px solid #0ea5e9">
      <span class="dot" style="background:#0ea5e9"></span>
      <h2>escape</h2>
      <span class="badge" style="background:#0ea5e91a;color:#0369a1">literal output · always available</span>
    </div>
    <table>
      <tr><td class="col-expr"><code>\{{name}}</code></td><td class="col-result"><code>\{{name}}</code></td></tr>
      <tr><td class="col-expr"><code>\\{{name}}</code></td><td class="col-result"><code>\\{{name}}</code></td></tr>
      <tr><td class="col-expr"><code>\\\{{name}}</code></td><td class="col-result"><code>\\\{{name}}</code></td></tr>
      <tr><td class="col-expr"><code>\\\\{{name}}</code></td><td class="col-result"><code>\\\\{{name}}</code></td></tr>
      <tr><td class="col-expr"><code>{{{{#raw}}}}{{name}}{{{{/raw}}}}</code></td><td class="col-result"><code>{{{{#raw}}}}{{name}}{{{{/raw}}}}</code></td></tr>
    </table>
  </div>

</div>
