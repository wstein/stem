{{> styles}}
<div class="sheet">
<div class="top">
  <div>
    <div class="brand"><svg class="mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <path d="M18 10 C14 10 13 12 13 16 L13 21 C13 23 12 24 10 24 C12 24 13 25 13 27 L13 32 C13 36 14 38 18 38" stroke="#7c4dff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M30 10 C34 10 35 12 35 16 L35 21 C35 23 36 24 38 24 C36 24 35 25 35 27 L35 32 C35 36 34 38 30 38" stroke="#7c4dff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M24 14 L24 40" stroke="#10b981" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M24 24 C21 22 19 22 17 23" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
  <path d="M24 30 C27 28 29 28 31 29" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
  <circle cx="24" cy="14" r="2" fill="#10b981"/>
</svg><span>Stem · Template Transformers · v1</span></div>
    <h1>Built-in Transformer<br><span class="accent">Reference Sheet</span></h1>
    <p class="sub">Pipe-chainable functions invoked inside <code>{{{{#raw}}}}{{ … }}{{{{/raw}}}}</code> tags. Only <em>default</em> is always on — the rest are enabled per render in the host. Every result below is rendered live by the engine.</p>
  </div>
  <div class="meta"><strong>CAPABILITY GROUPS</strong>
    <div class="meta-grid">
      <code>default</code><span>always active — output, serialisation, access, predicates</span>
      <code>format</code><span>low risk — atomic string transforms</span>
      <code>transform</code><span>medium risk — collection ops (audited)</span>
      <code>eval</code><span>opt-in only — evaluates Stem expressions</span>
      <code>escape</code><span>always available — literal braces &amp; raw blocks</span>
    </div>
  </div>
</div>
<div class="syntax">
  <div class="lbl">Pipe syntax<b>Three forms</b></div>
  <code>{{{{#raw}}}}{{ value |&gt; transformer }}{{{{/raw}}}}</code><code>{{{{#raw}}}}{{ value |&gt; transformer(arg1, arg2) }}{{{{/raw}}}}</code><code>{{{{#raw}}}}{{ value |&gt; t1 |&gt; t2(arg) |&gt; t3 }}{{{{/raw}}}}</code>
</div>
<div class="cols">
  <div class="col">
    
  <section class="card" style="--a:#6b7280;--abg:rgba(107,114,128,.12)">
    <div class="head"><span class="dot"></span><h2>default</h2><span class="pill">always on</span><span class="count">17</span><p class="desc">Output helpers, serialisation, collection access, predicates. Enabled with no opt-in.</p></div>
    <div class="rows"><div class="row"><div class="expr">unsafe <span class="t-pipe">|&gt;</span> escape_html</div><div class="out"><code>{{unsafe |> escape_html}}</code></div></div><div class="row"><div class="expr">quote <span class="t-pipe">|&gt;</span> escape_json</div><div class="out"><code>{{quote |> escape_json}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> take(<span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> json</div><div class="out"><code>{{fruits |> take(3) |> json}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> take(<span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> inspect</div><div class="out"><code>{{fruits |> take(3) |> inspect}}</code></div></div><div class="row"><div class="expr">missing <span class="t-pipe">|&gt;</span> default(<span class="t-str">"N/A"</span>)</div><div class="out"><code>{{missing |> default("N/A")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> take(<span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> take(3) |> join(", ")}}</code></div></div><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> log</div><div class="out"><code>{{title |> log}}</code><span class="note">↳ stderr · renders ""</span></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> first</div><div class="out"><code>{{fruits |> first}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> last</div><div class="out"><code>{{fruits |> last}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> len</div><div class="out"><code>{{fruits |> len}}</code></div></div><div class="row"><div class="expr">config <span class="t-pipe">|&gt;</span> lookup(<span class="t-str">"host"</span>)</div><div class="out"><code>{{config |> lookup("host")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> lookup(<span class="t-num">2</span>)</div><div class="out"><code>{{fruits |> lookup(2)}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> contains(<span class="t-str">"apple"</span>)</div><div class="out"><code>{{fruits |> contains("apple")}}</code></div></div><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> starts_with(<span class="t-str">"the"</span>)</div><div class="out"><code>{{title |> starts_with("the")}}</code></div></div><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> ends_with(<span class="t-str">"fox"</span>)</div><div class="out"><code>{{title |> ends_with("fox")}}</code></div></div><div class="row"><div class="expr">missing <span class="t-pipe">|&gt;</span> empty?</div><div class="out"><code>{{missing |> empty?}}</code></div></div><div class="row"><div class="expr">present <span class="t-pipe">|&gt;</span> present?</div><div class="out"><code>{{present |> present?}}</code></div></div></div>
    <div class="callout"><span class="ico">i</span><div><b>Composition tip.</b> Drop <code>|&gt; log</code> anywhere in a chain to inspect intermediate state without changing what renders.</div></div>
  </section>
    
  <section class="card" style="--a:#16a36b;--abg:rgba(22,163,107,.12)">
    <div class="head"><span class="dot"></span><h2>format</h2><span class="pill">low risk</span><span class="count">06</span><p class="desc">Atomic string transforms. Cannot iterate or recurse.</p></div>
    <div class="rows"><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> upcase</div><div class="out"><code>{{title |> upcase}}</code></div></div><div class="row"><div class="expr">blurb <span class="t-pipe">|&gt;</span> downcase</div><div class="out"><code>{{blurb |> downcase}}</code></div></div><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> capitalize</div><div class="out"><code>{{title |> capitalize}}</code></div></div><div class="row"><div class="expr">str <span class="t-pipe">|&gt;</span> trim</div><div class="out"><code>{{str |> trim}}</code></div></div><div class="row"><div class="expr">blurb <span class="t-pipe">|&gt;</span> truncate(<span class="t-num">20</span>, <span class="t-str">"…"</span>)</div><div class="out"><code>{{blurb |> truncate(20, "…")}}</code></div></div><div class="row"><div class="expr">title <span class="t-pipe">|&gt;</span> replace(<span class="t-str">"quick"</span>, <span class="t-str">"lazy"</span>)</div><div class="out"><code>{{title |> replace("quick", "lazy")}}</code></div></div></div>
    
  </section>
    
  <section class="card" style="--a:#7c5cf0;--abg:rgba(124,92,240,.14)">
    <div class="head"><span class="dot"></span><h2>eval</h2><span class="pill">dynamic · opt-in</span><span class="count">01</span><p class="desc">Treats a string as a Stem expression and evaluates it against the assign context.</p></div>
    <div class="rows"><div class="row"><div class="expr">expr <span class="t-pipe">|&gt;</span> eval</div><div class="out"><code>{{expr |> eval}}</code></div></div></div>
    <div class="callout warn"><span class="ico">!</span><div><b>Never enable for untrusted templates.</b> <code>eval</code> executes arbitrary Stem expressions at render time.</div></div>
  </section>
  </div>
  <div class="col">
    
  <section class="card" style="--a:#f29e3a;--abg:rgba(242,158,58,.14)">
    <div class="head"><span class="dot"></span><h2>transform</h2><span class="pill">medium risk · audited</span><span class="count">13</span><p class="desc">Full-collection traversals. Loading the group emits a one-shot audit event.</p></div>
    <div class="rows"><div class="row"><div class="expr">csv <span class="t-pipe">|&gt;</span> split(<span class="t-str">","</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">"|"</span>)</div><div class="out"><code>{{csv |> split(",") |> join("|")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> take(<span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> take(3) |> join(", ")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> drop(<span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> drop(3) |> join(", ")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> slice(<span class="t-num">1</span>, <span class="t-num">3</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> slice(1, 3) |> join(", ")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> take(<span class="t-num">4</span>) <span class="t-pipe">|&gt;</span> reverse <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> take(4) |> reverse |> join(", ")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> sort <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> sort |> join(", ")}}</code></div></div><div class="row"><div class="expr">people <span class="t-pipe">|&gt;</span> sort_by(<span class="t-str">"age"</span>) <span class="t-pipe">|&gt;</span> map(<span class="t-str">"name"</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{people |> sort_by("age") |> map("name") |> join(", ")}}</code></div></div><div class="row"><div class="expr">people <span class="t-pipe">|&gt;</span> map(<span class="t-str">"name"</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{people |> map("name") |> join(", ")}}</code></div></div><div class="row"><div class="expr">people <span class="t-pipe">|&gt;</span> filter(<span class="t-str">"lead"</span>) <span class="t-pipe">|&gt;</span> map(<span class="t-str">"name"</span>) <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{people |> filter("lead") |> map("name") |> join(", ")}}</code></div></div><div class="row"><div class="expr">sparse <span class="t-pipe">|&gt;</span> compact <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{sparse |> compact |> join(", ")}}</code></div></div><div class="row"><div class="expr">fruits <span class="t-pipe">|&gt;</span> uniq <span class="t-pipe">|&gt;</span> sort <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{fruits |> uniq |> sort |> join(", ")}}</code></div></div><div class="row"><div class="expr">nested <span class="t-pipe">|&gt;</span> flatten <span class="t-pipe">|&gt;</span> join(<span class="t-str">", "</span>)</div><div class="out"><code>{{nested |> flatten |> join(", ")}}</code></div></div><div class="row"><div class="expr">people <span class="t-pipe">|&gt;</span> group_by(<span class="t-str">"dept"</span>) <span class="t-pipe">|&gt;</span> json</div><div class="out"><code>{{people |> group_by("dept") |> json}}</code></div></div></div>
    <div class="callout"><span class="ico">A</span><div><b>Audit event.</b> Loading the transform group emits a one-shot audit event on load.</div></div>
  </section>
    
  <section class="card" style="--a:#3a7bf2;--abg:rgba(58,123,242,.14)">
    <div class="head"><span class="dot"></span><h2>escape</h2><span class="pill">literal output</span><span class="count">05</span><p class="desc">Consume-1 backslash rule and {{{{#raw}}}} blocks emit literal braces. Always available.</p></div>
    <div class="rows"><div class="row"><div class="expr">{{{{#raw}}}}\{{name}}{{{{/raw}}}}</div><div class="out"><code>\{{name}}</code></div></div><div class="row"><div class="expr">{{{{#raw}}}}\\{{name}}{{{{/raw}}}}</div><div class="out"><code>\\{{name}}</code></div></div><div class="row"><div class="expr">{{{{#raw}}}}\\\{{name}}{{{{/raw}}}}</div><div class="out"><code>\\\{{name}}</code></div></div><div class="row"><div class="expr">{{{{#raw}}}}\\\\{{name}}{{{{/raw}}}}</div><div class="out"><code>\\\\{{name}}</code></div></div><div class="row"><div class="expr">{{raw_src}}</div><div class="out"><code>{{{{#raw}}}}{{name}}{{{{/raw}}}}</code></div></div></div>
    
  </section>
    <section class="card" style="--a:#18173a;--abg:#e6e5f0">
      <div class="head"><span class="dot"></span><h2>Loading groups · Elixir</h2><span class="pill">host config</span><p class="desc">Pass transformer modules to <code>Stem.Unsafe.eval_string/2</code>. The default group needs no opt-in.</p></div>
      <pre class="codeblock"><span class="c"># format group (low risk)</span>
<span class="m">Stem.Unsafe</span>.<span class="f">eval_string</span>(template, <span class="k">assigns:</span> data,
  <span class="k">transformers:</span> <span class="m">Stem.Transformers.Strings</span>.<span class="f">all</span>())

<span class="c"># transform group (medium risk — audited)</span>
<span class="m">Stem.Unsafe</span>.<span class="f">eval_string</span>(template, <span class="k">assigns:</span> data,
  <span class="k">transformers:</span> <span class="m">Stem.Transformers.Collections</span>.<span class="f">all</span>())

<span class="c"># everything bundled</span>
<span class="m">Stem.Unsafe</span>.<span class="f">eval_string</span>(template, <span class="k">assigns:</span> data,
  <span class="k">transformers:</span> <span class="m">Stem.Transformers.Standard</span>.<span class="f">all</span>())</pre>
    </section>
  </div>
</div>
<div class="foot"><div class="legend"><span><i style="background:#6b7280"></i>default · always on</span><span><i style="background:#16a36b"></i>format · low risk</span><span><i style="background:#f29e3a"></i>transform · medium risk · audited</span><span><i style="background:#7c5cf0"></i>eval · dynamic · opt-in</span><span><i style="background:#3a7bf2"></i>escape · literal output</span></div><div>STEM · TRANSFORMERS · QUICK REFERENCE · v1</div></div>
</div>
