<div class="top">
  <div class="mark" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none">
      <!-- outer { -->
      <path d="M10 11 C6 11 6 13 6 17 L6 21 C6 23 3 24 3 24 C3 24 6 25 6 27 L6 31 C6 35 6 37 10 37" stroke="#7c4dff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- inner { -->
      <path d="M16 11 C12 11 12 13 12 17 L12 21 C12 23 9 24 9 24 C9 24 12 25 12 27 L12 31 C12 35 12 37 16 37" stroke="#7c4dff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
      <!-- inner } -->
      <path d="M32 11 C36 11 36 13 36 17 L36 21 C36 23 39 24 39 24 C39 24 36 25 36 27 L36 31 C36 35 36 37 32 37" stroke="#7c4dff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
      <!-- outer } -->
      <path d="M38 11 C42 11 42 13 42 17 L42 21 C42 23 45 24 45 24 C45 24 42 25 42 27 L42 31 C42 35 42 37 38 37" stroke="#7c4dff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- stem -->
      <path d="M24 13 L24 38" stroke="#10b981" stroke-width="2.4" stroke-linecap="round"/>
      <!-- branches -->
      <path d="M24 22 C21 20 19 20 17 21" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
      <path d="M24 29 C27 27 29 27 31 28" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
      <circle cx="24" cy="13" r="2" fill="#10b981"/>
    </svg>
  </div>
  <div class="titles">
    <div class="brand">
      <span>Stem · v1</span>
    </div>
    <h1>Stem Template <span class="accent">Reference Sheet</span></h1>
  </div>
</div>
<div class="syntax">
  <div class="syntax-row">
    <div class="lbl">Pipe<b>value first</b></div>
    <code>{{{{#raw}}}}{{ value | transformer }}{{{{/raw}}}}</code>
    <code>{{{{#raw}}}}{{ value | transformer arg1 arg2 }}{{{{/raw}}}}</code>
  </div>
  <div class="syntax-row">
    <div class="lbl">Prefix<b>name first</b></div>
    <code>{{{{#raw}}}}{{ transformer value }}{{{{/raw}}}}</code>
    <code>{{{{#raw}}}}{{ transformer value arg1 arg2 }}{{{{/raw}}}}</code>
  </div>
  <div class="syntax-row">
    <div class="lbl">Keys<b>literal · index</b></div>
    <code>{{{{#raw}}}}{{ user.[full name] }}{{{{/raw}}}}</code>
    <code>{{{{#raw}}}}{{ items.[2] }}{{{{/raw}}}}</code>
  </div>
  <p class="syntax-note">
    <code>( … )</code> groups a sub-call — the prefix form of the pipe:
    <code>{{{{#raw}}}}{{ name | trim | capitalize }}{{{{/raw}}}}</code> =
    <code>{{{{#raw}}}}{{ capitalize (trim name) }}{{{{/raw}}}}</code>.
    <code>[ … ]</code> reads a key that isn't a bare word (spaces, dashes, dots) or a list index.
  </p>
</div>